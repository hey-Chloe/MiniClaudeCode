# Required for real v5 mode
OPENAI_API_KEY=
MINICLAUDE_MODEL=deepseek-chat

# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.deepseek.com

# Runtime and agent limits
MINICLAUDE_WORKSPACE=.
MINICLAUDE_RUNTIME=local
MINICLAUDE_PERMISSION_MODE=default
MINICLAUDE_MAX_TURNS=20
MINICLAUDE_TIMEOUT=120
MINICLAUDE_MAX_OUTPUT_CHARS=100000
